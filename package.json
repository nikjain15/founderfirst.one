{
  "name": "founderfirst-web",
  "private": true,
  "version": "0.0.0",
  "description": "FounderFirst monorepo \u2014 marketing site (apps/web, Astro), admin SPA, shared design system, and vendored Penny demo.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @ff/web dev",
    "build:web": "pnpm --filter @ff/web build",
    "check:css": "tsx scripts/check-css-imports.ts",
    "check:css-vars": "tsx scripts/check-css-vars.ts",
    "check:app-strings": "tsx scripts/check-app-strings.ts",
    "check:authed-headings": "tsx scripts/check-authed-headings.ts",
    "check:tenant": "tsx scripts/check-tenant-predicate.ts",
    "check:definer-guard": "tsx scripts/check-definer-tenant-guard.ts",
    "check:inference": "tsx packages/inference/test/parity.ts",
    "check:judge": "tsx packages/inference/test/judge.ts",
    "check:retention": "tsx packages/inference/test/retention.ts",
    "gen:retention-doc": "tsx scripts/check-retention-doc.ts",
    "check:retention-doc": "tsx scripts/check-retention-doc.ts --check",
    "test:chat-latency": "tsx packages/inference/test/chat-latency.ts",
    "eval:gates": "tsx evals/run.ts",
    "check:vendor": "tsx scripts/check-inference-vendor.ts",
    "seed:kernel": "tsx scripts/seed-kernel.ts",
    "check:kernel-seed": "tsx scripts/seed-kernel.ts --check",
    "seed:tax": "tsx scripts/seed-tax.ts",
    "check:tax-seed": "tsx scripts/seed-tax.ts --check",
    "seed:depreciation": "tsx scripts/seed-depreciation.ts",
    "check:depreciation-seed": "tsx scripts/seed-depreciation.ts --check",
    "check:law-literals": "tsx scripts/check-law-literals.ts",
    "check:kernel-hardcodes": "tsx scripts/check-kernel-hardcodes.ts",
    "reg-watcher": "tsx scripts/regulatory-watcher/run.ts",
    "check:reg-watcher": "tsx scripts/regulatory-watcher/replay-test.ts",
    "vendor:inference": "tsx scripts/vendor-inference.ts",
    "build": "tsx scripts/check-css-imports.ts && tsx scripts/check-tenant-predicate.ts && tsx scripts/check-definer-tenant-guard.ts && tsx scripts/check-inference-vendor.ts && tsx packages/inference/test/judge.ts && tsx scripts/build-all.ts",
    "vendor:demo": "tsx scripts/vendor-demo.ts",
    "test:guards": "tsx --test scripts/tests/*.test.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "test:responsive": "pnpm build && node tools/responsive-ci/run.mjs",
    "test:responsive:only": "node tools/responsive-ci/run.mjs",
    "cost:model": "node scripts/cost-model.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axe-core": "4.12.1",
    "playwright": "^1.45.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.18",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "js-yaml@>=3.0.0 <3.15.0": "^3.15.0",
      "protobufjs@<=7.6.0": "^7.6.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "dompurify@<3.4.12": "^3.4.12",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  }
}
